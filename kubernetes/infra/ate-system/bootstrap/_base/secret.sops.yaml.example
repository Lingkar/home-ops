# Copy to secret.sops.yaml, replace the placeholders with the Garage key from
# `garage key show substrate`, then encrypt in place:
#   sops -e -i secret.sops.yaml
apiVersion: v1
kind: Secret
metadata:
  name: substrate-garage-credentials
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: REPLACE_WITH_GARAGE_KEY_ID
  AWS_SECRET_ACCESS_KEY: REPLACE_WITH_GARAGE_SECRET_KEY
